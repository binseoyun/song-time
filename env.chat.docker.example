# db-chat(AI 챗봇 전용 MySQL) 실행용 환경변수 템플릿
# 이 파일을 `.env.chat.docker`로 복사한 뒤 실제 값을 채우세요. (.env.chat.docker는 절대 커밋 금지)
#   cp env.chat.docker.example .env.chat.docker
#
# ADR-010 §3/§10: ai-server가 직접 소유하는 db-chat은 기존 db(env.docker.example)와
# 완전히 분리된 컨테이너·자격증명을 쓴다 — 값을 공유하거나 재사용하지 않는다.

# --- db-chat 컨테이너 초기화 (공식 mysql:8.0 이미지가 요구하는 고정 키 이름) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=chat_db
MYSQL_USER=
MYSQL_PASSWORD=

# --- ai-server가 db-chat에 연결할 때 쓰는 이름 (위 값과 각각 일치해야 함) ---
CHAT_DB_HOST=db-chat
CHAT_DB_PORT=3306
CHAT_DB_NAME=chat_db
CHAT_DB_USER=
CHAT_DB_PASSWORD=

# --- redis-chat (인증 없음 — 로컬 개발 기준) ---
CHAT_REDIS_HOST=redis-chat
CHAT_REDIS_PORT=6379
