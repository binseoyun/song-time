# AI Server 로컬 개발용 환경변수 템플릿
# 이 파일을 `.env`로 복사한 뒤 실제 값을 채우세요. (.env는 절대 커밋 금지)
# 주의: 코드(main.py)는 GEMINI_API_KEY(단수)를 읽습니다.

GEMINI_API_KEY=
GENAI_MODEL=models/gemini-pro-latest
COURSE_API_URL=http://localhost:8000/api/courses

# --- AI 챗봇(ADR-010, Stage 0-5) ---
# Tool이 호출하는 Node 백엔드 기준 URL (GET {BACKEND_BASE_URL}/api/courses 등)
BACKEND_BASE_URL=http://localhost:8000
# Tool 호출(function calling)에 쓰는 모델 — langchain-google-genai 기준
CHAT_MODEL=gemini-3.6-flash
CHAT_MAX_ITERATIONS=6
CHAT_HISTORY_TURNS=10
CHAT_CACHE_TTL_SECONDS=1800

# --- 채팅 전용 인프라(db-chat/redis-chat, 이슈 #66) ---
CHAT_DB_HOST=localhost
CHAT_DB_PORT=3311
CHAT_DB_NAME=chat_db
CHAT_DB_USER=
CHAT_DB_PASSWORD=
CHAT_REDIS_HOST=localhost
CHAT_REDIS_PORT=6380
