# Docker Compose 실행용 환경변수 템플릿
# 이 파일을 `.env.docker`로 복사한 뒤 실제 값을 채우세요. (.env.docker는 절대 커밋 금지)
#   cp env.docker.example .env.docker

# --- MySQL 컨테이너 초기화 ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cloudsystem_db
MYSQL_USER=
MYSQL_PASSWORD=

# --- Backend가 사용하는 DB 접속 정보 (위 MySQL 값과 일치해야 함) ---
DB_NAME=cloudsystem_db
DB_USER=
DB_PASSWORD=

# --- 인증 ---
# 예: openssl rand -base64 32 로 생성
JWT_SECRET=

# --- AI Server ---
GEMINI_API_KEY=
GENAI_MODEL=models/gemini-pro-latest
COURSE_API_URL=http://backend:8000/api/courses

# --- AI 챗봇(ADR-010, Stage 0-5) ---
BACKEND_BASE_URL=http://backend_1:8000
CHAT_MODEL=gemini-3.6-flash
CHAT_MAX_ITERATIONS=6
CHAT_HISTORY_TURNS=10
CHAT_CACHE_TTL_SECONDS=1800
